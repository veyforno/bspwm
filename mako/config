# Lokasi dan Tampilan Baris Baru
max-visible=1
sort=-time

# Spesifikasi Tampilan (Style)
layer=top
anchor=top-center
font=JetBrainsMono Nerd font 10
background-color=#1e1e2edd
text-color=#cdd6f4
border-size=0
border-radius=8
progress-color=over #313244

# Dimensi & Jarak (Padding)
width=300
height=110
margin=20
padding=15
icons=1
max-icon-size=64

# Waktu Notifikasi Muncul (Milidetik)
default-timeout=3000

# Pengaturan Kategori Khusus (Urgent)
[urgency=high]
border-color=#f38ba8
default-timeout=0
