#! /bin/sh

pgrep -x sxhkd > /dev/null || sxhkd &

bspc monitor -d I II III IV V #VI VII VIII IX X

bspc config border_width         2.5
bspc config window_gap           7

bspc config split_ratio          0.52
bspc config borderless_monocle   true
bspc config gapless_monocle      true

bspc rule -a Gimp desktop='^8' state=floating follow=on
bspc rule -a Chromium desktop='^2'
bspc rule -a mplayer2 state=floating
bspc rule -a Kupfer.py focus=on
bspc rule -a Screenkey manage=off

#bspc rule -a mpv:wp-transition state=fullscreen focus=off
#bspc rule -a cava-bg state=floating layer=below sticky=on focus=off \
#  border=off locked=on manage=on rectangle=1400x260+260+780
#bspc rule -a rmpc-bg state=floating layer=below sticky=on focus=off \
#  border=off locked=on manage=on rectangle=500x300+260+460

pgrep -x picom >/dev/null || picom &
#~/.local/bin/cava-wallpaper.sh &

~/.fehbg &
#picom &
$HOME/.config/polybar/launch.sh &
