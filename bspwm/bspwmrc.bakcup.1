#! /bin/sh

xset r rate 250 50

export QT_QPA_PLATFORMTHEME=qt5ct
export QT_STYLE_OVERRIDE=kvantum

pgrep -x sxhkd >/dev/null || sxhkd &

bspc monitor -d I II III IV V VI VII VIII IX X

bspc config border_width 0
bspc config window_gap 3

bspc config split_ratio 0.50
bspc config borderless_monocle true
bspc config gapless_monocle true

bspc rule -a Gimp desktop='^8' state=floating follow=on
bspc rule -a Chromium desktop='^2'
bspc rule -a mplayer2 state=floating
bspc rule -a Kupfer.py focus=on
bspc rule -a Screenkey manage=off

#killall -q picom
#while pgrep -u $UID -x picom >/dev/null; do sleep 0.2; done
#picom -b &

if DBUS_SESSION_BUS_ADDRESS=$DBUS_SESSION_BUS_ADDRESS dbus-update-activation-environment --systemd DISPLAY XAUTHORITY; then
  systemctl --user stop xdg-desktop-portal xdg-desktop-portal-kde 2>/dev/null
  systemctl --user start xdg-desktop-portal
fi &

if [ -f "$HOME/.fehbg" ]; then
  sh "$HOME/.fehbg" &
fi

$HOME/.config/polybar/launch.sh &

xset s 300 300
xss-lock -- betterlockscreen -l dimblur --fx fade &
(
  sleep 0.8 # Jeda agar bspwm beres memuat polybar dan wallpaper

  # Ambil resolusi monitor saat ini secara dinamis untuk hitung titik tengah
  eval "$(xdotool getdisplaygeometry | awk '{print "W="$1";H="$2"}')"
  X=$(((W - 999) / 2))
  Y=$(((H - 222) / 2))

  # Jalankan Kitty dengan memaksa posisi koordinat global semenjak dilahirkan
  kitty --title "SPLASH_FETCH" \
    -o remember_window_size=no \
    -o initial_window_width=999 \
    -o initial_window_height=222 \
    -o hide_window_decorations=yes \
    ~/fetchku/myfetchpng1 &

  # Tangkap jendelanya secara paksa dan kunci mati dari bspwm
  for i in $(seq 1 40); do
    # Cari Window ID berdasarkan Judul Jendela yang Unik
    NODE_ID=$(xdotool search --name "SPLASH_FETCH" 2>/dev/null | head -n 1)

    if [ -n "$NODE_ID" ]; then
      # 1. Pindahkan secara paksa ke titik tengah koordinat X dan Y global
      xdotool windowmove "$NODE_ID" $X $Y

      # 2. Paksa bspwm mengubah statusnya menjadi Floating, Locked, Sticky, dan taruh di atas
      bspc node "$NODE_ID" -t floating
      bspc node "$NODE_ID" -g locked=on sticky=on
      bspc node "$NODE_ID" -l above
      break
    fi
    sleep 0.05
  done
) &
