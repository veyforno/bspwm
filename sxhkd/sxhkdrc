	scrot -s '%Y-%m-%d-%H%M%S.png' -e 'mkdir -p ~/Pictures && mv $f ~/Pictures && xclip -selection clipboard -t image/png -i ~/Pictures/$f'

#reload polybar
super + ctrl + p
	killall polybar; polybar &

#reload picom
super + ctrl + i
	killall picom; picom &

#ganti wallpaper
super + ctrl + shift + w
	~/.local/bin/rofi-wallpaper.sh

#lockscreen
super + ctrl + shift + l
	~/.local/bin/lockscreen-wallpaper.sh

#power off
super + Escape
	~/.config/rofi/powermenu.sh

#wifian

#lagu + fetch
super + ctrl + m
    	bspc rule -a RMPC_TUI -o state=floating rectangle=666x666+240+111; \
    	bspc rule -a Cava -o state=floating rectangle=666x666+1111+111; \
	bspc rule -a fetch -o state=floating rectangle=999x222+555+844; \
   	kitty --class RMPC_TUI -e rmpc & \
